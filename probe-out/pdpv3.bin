A,CAEF,wBAAA,+BAAA,CAAA,mBAAA,CACA,4BACE,gCAAA,CACA,oBAAA,CACA,eAAA,CACA,uCAAA,CAIF,0BACE,UAAA,CACA,6CAAA",sourcesContent:["/* =====================================================================\n * Product Detail Page v3 — visual stylesheet\n *\n * Strictly follows docs/Revamp/Figma/pdp_revamp1.css (Figma export):\n * exact paddings, fonts (JPM AM Pro), and palette\n * (#0E3442/#21292E gradient, #52D8E6 cyan, #565A5D ink, #41464A divider).\n * All selectors are scoped under `.pdp-v3` so this file cannot collide\n * with site.css / bootstrap. product-detail-v3.ftlh loads NO other CSS.\n * ===================================================================== */\n\n.pdp-v3,\n.pdp-v3 * {\n  box-sizing: border-box;\n}\n\n.pdp-v3 {\n  --c-ink:           #21292E;\n  --c-ink-2:         #565A5D;\n  --c-ink-3:         #8C8E90;\n  --c-ink-4:         #ABADAF;\n  --c-divider:       #E2E4E5;\n  --c-divider-dark:  #41464A;\n  --c-cyan:          #52D8E6;\n  --c-cyan-strong:   #3AB0C5;\n  --c-cyan-soft:     #DBF5F7;\n  --c-white:         #FFFFFF;\n  --c-black:         #000000;\n\n  font-family: 'JPM AM Pro', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  color: var(--c-ink);\n  background: var(--c-white);\n}\n\n.pdp-v3__main { width: 100%; }\n\n/* ── Primary nav (1536×112) ────────────────────────────────────────── */\n.pdp-v3__primary-nav {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: flex-end;\n  height: 112px;\n  padding: 0 64px;\n  background: var(--c-white);\n  border-bottom: 1px solid var(--c-divider);\n}\n\n.pdp-v3__logo {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: flex-start;\n  width: 144px;\n  height: 112px;\n  gap: 4px;\n  text-decoration: none;\n  color: var(--c-ink);\n}\n.pdp-v3__logo-jpm {\n  font-weight: 700;\n  font-size: 22px;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n.pdp-v3__logo-am {\n  font-weight: 400;\n  font-size: 9px;\n  letter-spacing: 0.18em;\n  color: var(--c-ink-2);\n}\n\n.pdp-v3__nav { display: flex; align-items: flex-end; height: 100%; }\n.pdp-v3__nav-list {\n  display: flex;\n  flex-direction: row;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  height: 64px;\n}\n.pdp-v3__nav-item {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: center;\n  padding: 4px 0 1px;\n  gap: 38px;\n  height: 64px;\n  cursor: pointer;\n}\n.pdp-v3__nav-label {\n  display: flex;\n  align-items: center;\n  padding: 0 16px;\n  height: 24px;\n  font-weight: 500;\n  font-size: 16px;\n  line-height: 24px;\n  color: var(--c-ink-2);\n  white-space: nowrap;\n}\n.pdp-v3__nav-underline {\n  align-self: stretch;\n  height: 3px;\n  background: transparent;\n}\n.pdp-v3__nav-item:hover .pdp-v3__nav-label { color: var(--c-ink); }\n.pdp-v3__nav-item.is-active .pdp-v3__nav-label { color: var(--c-ink); }\n.pdp-v3__nav-item.is-active .pdp-v3__nav-underline { background: var(--c-cyan-strong); }\n\n.pdp-v3__nav-search {\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  margin: 0;\n  border: 0;\n  background: transparent;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  margin-bottom: 40px;\n  border-radius: 50%;\n}\n.pdp-v3__nav-search:hover { background: #F2F3F4; }\n\n/* ── Hero / Fund promo (1536×460) ──────────────────────────────────── */\n.pdp-v3__hero {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  padding: 56px 64px;\n  gap: 80px;\n  width: 100%;\n  min-height: 460px;\n  background: linear-gradient(203.73deg, #0E3442 47.3%, #21292E 88.79%);\n}\n\n.pdp-v3__hero-container {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 40px;\n  width: 100%;\n  max-width: 1408px;\n}\n\n.pdp-v3__hero-top {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n  height: 44px;\n}\n\n.pdp-v3__ticker-banner {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 16px;\n  height: 44px;\n}\n.pdp-v3__ticker {\n  display: inline-flex;\n  align-items: center;\n  height: 44px;\n  padding: 0 4px;\n  font-weight: 400;\n  font-size: 36px;\n  line-height: 44px;\n  color: var(--c-white);\n  border-bottom: 4px solid var(--c-cyan-strong);\n}\n.pdp-v3__cusip-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  height: 22px;\n  font-weight: 400;\n  font-size: 14px;\n  line-height: 22px;\n  letter-spacing: 1.7px;\n  text-transform: uppercase;\n  color: var(--c-white);\n}\n\n.pdp-v3__hero-grid {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  gap: 40px;\n  width: 100%;\n}\n.pdp-v3__hero-left {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 40px;\n  width: 563px;\n  flex-shrink: 0;\n}\n.pdp-v3__hero-right {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 16px;\n  flex: 1 1 auto;\n  min-width: 0;\n}\n\n.pdp-v3__fund-name {\n  margin: 0;\n  width: 100%;\n  font-weight: 300;\n  font-size: 52px;\n  line-height: 60px;\n  letter-spacing: -0.6px;\n  color: var(--c-white);\n}\n\n.pdp-v3__hero-ctas {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 24px;\n  height: 44px;\n}\n/* Pill button — explicit reset (not `all: unset`) so the descendant\n   `color` inheritance is preserved on every browser. */\n.pdp-v3__pill {\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  margin: 0;\n  border: 0;\n  background: transparent;\n  font-family: inherit;\n  font-weight: 500;\n  font-size: 16px;\n  line-height: 24px;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 44px;\n  min-width: 120px;\n  padding: 0 24px;\n  border-radius: 160px;\n  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;\n}\n.pdp-v3__pill > span { color: inherit; }\n.pdp-v3__pill > svg  { flex: none; }\n\n.pdp-v3__pill--outline {\n  border: 1px solid var(--c-cyan);\n  color: var(--c-white);\n  background: transparent;\n}\n.pdp-v3__pill--outline:hover {\n  background: rgba(82, 216, 230, 0.16);\n  color: var(--c-white);\n  border-color: var(--c-white);\n}\n\n.pdp-v3__pill--filled {\n  background: var(--c-cyan);\n  color: var(--c-black);\n}\n.pdp-v3__pill--filled:hover { background: var(--c-cyan-strong); }\n\n.pdp-v3__icon-circle {\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  margin: 0;\n  border: 0;\n  background: transparent;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  color: var(--c-cyan-soft);\n}\n.pdp-v3__icon-circle:hover { background: rgba(255, 255, 255, 0.06); }\n\n/* ── Stat clusters ─────────────────────────────────────────────────── */\n.pdp-v3__cluster-row {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  gap: 40px;\n  width: 100%;\n}\n.pdp-v3__cluster {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 8px;\n  flex: 1 1 0;\n  min-width: 220px;\n  padding: 0 0 16px;\n  border-bottom: 1px solid var(--c-divider-dark);\n}\n\n.pdp-v3__cluster-title {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 8px;\n  height: 20px;\n  width: 100%;\n}\n.pdp-v3__cluster-title-text {\n  font-weight: 400;\n  font-size: 12px;\n  line-height: 20px;\n  letter-spacing: 1.2px;\n  text-transform: uppercase;\n  color: var(--c-white);\n}\n.pdp-v3__cluster-title-text.is-tooltip {\n  text-decoration: underline dotted;\n  text-underline-offset: 3px;\n}\n.pdp-v3__cluster-asof {\n  font-style: italic;\n  font-weight: 400;\n  font-size: 10px;\n  line-height: 16px;\n  color: var(--c-ink-4);\n}\n\n.pdp-v3__medal-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  height: 20px;\n}\n.pdp-v3__medal-label {\n  font-weight: 500;\n  font-size: 14px;\n  line-height: 20px;\n  letter-spacing: 1px;\n  color: var(--c-white);\n}\n\n.pdp-v3__star-row {\n  display: inline-flex;\n  align-items: center;\n  gap: 0;\n  height: 16px;\n}\n\n.pdp-v3__cluster-stats {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  gap: 40px;\n  width: 100%;\n}\n.pdp-v3__cluster-stat {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-end;\n  gap: 8px;\n  min-width: 124px;\n}\n.pdp-v3__cluster-value {\n  font-weight: 300;\n  font-size: 24px;\n  line-height: 24px;\n  color: var(--c-white);\n}\n\n.pdp-v3__cluster-meta {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 4px;\n  width: 100%;\n  min-height: 12px;\n}\n.pdp-v3__meta-text {\n  font-weight: 400;\n  font-size: 12px;\n  line-height: 14px;\n  color: var(--c-ink-4);\n}\n.pdp-v3__meta-text--tooltip {\n  font-weight: 500;\n  color: var(--c-white);\n  text-decoration: underline dotted;\n  text-underline-offset: 3px;\n}\n.pdp-v3__cluster-pipe {\n  display: inline-block;\n  width: 1px;\n  height: 12px;\n  background: var(--c-divider-dark);\n  margin: 0 4px;\n}\n\n/* ── Jump-link bar (in-page section menu, 1536×88) ─────────────────── */\n.pdp-v3__jumpbar {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  width: 100%;\n  background: #21292E;\n  border-top: 1px solid var(--c-divider-dark);\n  border-bottom: 1px solid var(--c-divider-dark);\n}\n.pdp-v3__jumpbar-container {\n  display: flex;\n  flex-direction: row;\n  align-items: stretch;\n  padding: 0 64px;\n  height: 78px;\n}\n\n.pdp-v3__jumpbar-label {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 8px;\n  padding: 0 24px 0 0;\n  flex: 0 0 auto;\n}\n.pdp-v3__jumpbar-eyebrow {\n  font-family: 'JPM AM Pro', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-weight: 400;\n  font-size: 14px;\n  line-height: 22px;\n  letter-spacing: 1.7px;\n  text-transform: uppercase;\n  color: var(--c-white);\n}\n.pdp-v3__jumpbar-icon {\n  display: inline-flex;\n  width: 24px;\n  height: 24px;\n  color: var(--c-white);\n}\n\n.pdp-v3__jumpbar-links {\n  display: flex;\n  flex-direction: row;\n  align-items: stretch;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  flex: 1 1 auto;\n}\n.pdp-v3__jumpbar-item {\n  display: flex;\n  flex: 1 1 0;\n  min-width: 100px;\n  max-width: 350px;\n}\n.pdp-v3__jumplink {\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  margin: 0;\n  border: 0;\n  background: transparent;\n  text-align: center;\n  font-family: inherit;\n  font-weight: 400;\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--c-white);\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  padding: 0 24px;\n  transition: background-color 120ms ease, color 120ms ease;\n}\n.pdp-v3__jumplink:hover { background: rgba(82, 216, 230, 0.12); color: var(--c-cyan); }\n.pdp-v3__jumplink.is-active {\n  background: var(--c-divider-dark);\n  color: var(--c-white);\n  font-weight: 500;\n  box-shadow: inset 0 -3px 0 var(--c-cyan);\n}\n\n/* 8px progress strip below the link row */\n.pdp-v3__jumpbar-progress {\n  height: 8px;\n  border-bottom: 1px solid var(--c-divider-dark);\n}\n"],sourceRoot:""}]);const o=i},15287:(e,n)=>{var t=Symbol.for("react.element"),r=Symbol.for("react.portal"),l=Symbol.for("react.fragment"),a=Symbol.for("react.strict_mode"),i=Symbol.for("react.profiler"),o=Symbol.for("react.provider"),u=Symbol.for("react.context"),s=Symbol.for("react.forward_ref"),c=Symbol.for("react.suspense"),d=Symbol.for("react.memo"),f=Symbol.for("react.lazy"),p=Symbol.iterator,A={isMounted:function(){return!1},enqueueForceUpdate:function(){},enqueueReplaceState:function(){},enqueueSetState:function(){}},h=Object.assign,m={};function g(e,n,t){this.props=e,this.context=n,this.refs=m,this.updater=t||A}function v(){}function y(e,n,t){this.props=e,this.context=n,this.refs=m,this.updater=t||A}g.prototype.isReactComponent={},g.protot