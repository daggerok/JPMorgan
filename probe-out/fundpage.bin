		documents= {"46641Q332":[{"documentType":"Brochure","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/jepi-jepq-flyer.pdf","isGlassDoor":false,"isProtected":false,"language":"en","title":"Flyer: Widen your search for income with a JEPI/JEPQ blend","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":null,"onDate":"2026-03-30T22:43:00.000-0400"},{"documentType":"Fund Story","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/fund-story/STO-JEPI.pdf","isGlassDoor":false,"isProtected":false,"language":"en","title":"Fund Story: Equity Premium Income ETF","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":" ","onDate":"2026-06-30T10:44:00.000-0400"},{"documentType":"Dividend Distributions","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/supplemental/income-distribution-rates/jpmorgan-etfs-2026-distribution-notice.pdf","isGlassDoor":false,"isProtected":false,"language":"en","title":"ETF Dividend Calendar 2026","docCategory":"Supplemental Documents (US) ; Supplemental Information (EMEA) ; Fund Distribution Record (APAC)","childDoc":null,"description":null,"onDate":"2026-07-30T01:58:00.000-0400"},{"documentType":"Dividend Distributions","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/supplemental/income-distribution-rates/jpmorgan-etfs-2026-distribution-notice.pdf","isGlassDoor":false,"isProtected":false,"language":"es","title":"ETF Dividend Calendar 2026","docCategory":"Supplemental Documents (US) ; Supplemental Information (EMEA) ; Fund Distribution Record (APAC)","childDoc":null,"description":null,"onDate":"2026-07-30T01:58:00.000-0400"},{"documentType":"Commentary","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/commentary/FC-JEPI.PDF","isGlassDoor":false,"isProtected":false,"language":"en","title":"Commentary: Equity Premium Income ETF (JEPI)","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":null,"onDate":"2026-06-30T02:40:00.000-0400"},{"documentType":"Fact Sheet (US EMEA)","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/fact-sheet/etfs/FS-JEPI.PDF","isGlassDoor":false,"isProtected":false,"language":"es","title":"Factsheet: JPMorgan Equity Premium Income ETF (ETF Shares)","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":" ","onDate":"2026-07-31T09:25:00.000-0400"},{"documentType":"Fact Sheet (US EMEA)","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/fact-sheet/etfs/FS-JEPI.PDF","isGlassDoor":false,"isProtected":false,"language":"en","title":"Factsheet: JPMorgan Equity Premium Income ETF (ETF Shares)","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":" ","onDate":"2026-07-31T09:25:00.000-0400"},{"documentType":"Product Presentation","docURL":"https://am.jpmorgan.com/content/dam/jpm-am-aem/americas/us/en/literature/product-presentation/protected/presentation-equity-premium-income-etf.pdf","isGlassDoor":true,"isProtected":false,"language":"en","title":"Presentation: JPM Equity Premium Income","docCategory":"Fund Literature (US APAC) ; Product Literature (EMEA)","childDoc":null,"description":null,"onDate":"2026-08-31T03:35:00.000-0400"},{"documentType":"Annual Report","docURL":"https://am.jpmorgan.com/JPMorgan/TVT/46641Q332/AR?site=JPMorganv3","isGlassDoor":false,"isProtected":false,"language":"en","title":"Annual Report - JEPI","docCategory":"Regulatory Documents (US APAC) ; Legal Documents (EMEA) ; Financial Report (APAC based on product type)","childDoc":null,"description":"JPMorgan Equity Premium Income ETF-ETF Shares Annual Report","onDate":"2026-09-19T07:09:19.781-0400"},{"documentType":"Prospectus","docURL":"https://am.jpmorgan.com/JPMorgan/TVT/46641Q332/P?site=JPMorg