		fundManagers ={"4342A6F7E0434A65E053A9B759A98FF9":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/Zingone_Raffaele_270.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/raffaele-zingone/"},"4342A6F7E11E4A65E053A9B759A98FF9":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/Reiner_Hamilton_270.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/hamilton-reiner/"},"1DEC4F6C46D08166E0634EB966A94B5C":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/matt-bensen-2023.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/matt-bensen/"},"78D5880BED082633E04400144FB99A4A":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/Zingone_Raffaele_270.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/raffaele-zingone/"},"261499DC6B5998EEE0639B0B1DA9F87C":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/matt-bensen-2023.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/matt-bensen/"},"38BEF19A5B7F1FE4E05362C74BA92737":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/Zingone_Raffaele_270.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/raffaele-zingone/"},"DD8C7F12029F40B7E053D4021DA9FD55":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/judy-jansen.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/judy-jansen/"},"1DEC50C12D8C014FE0634EB966A9F172":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/judy-jansen.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/judy-jansen/"},"0A45A67713F21208E05400144FB99A4A":{"imageURL":"https://cdn.jpmorganfunds.com/content/dam/jpm-am-aem/global/en/images/bios/Reiner_Hamilton_270.png","libraryPage":null,"managerDisclosure":null,"managerDisclosureSymbol":null,"profileURL":"https://am.jpmorgan.com/us/en/asset-management/adv/bios/hamilton-reiner/"}};
