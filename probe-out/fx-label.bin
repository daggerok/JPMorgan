he date range must be at least 1 year.","pdp-performance-chart-tooltip":"NAV","pdp-performance-chart-fund-hover-box":"NAV","pdp-performance-card-since-inception":"Since inception*","pdp-performance-card-oneMonth":"1 Month","pdp-performance-card-threeMonths":"3 Months","pdp-performance-card-sixMonths":"6 Months","pdp-performance-card-oneYear":"1 Year","pdp-performance-card-threeYears":"3 Years","pdp-performance-card-fiveYears":"5 Years","pdp-performance-card-tenYears":"10 Years","pdp-performance-card-fifteenYears":"15 Years","pdp-performance-card-tab-monthly-label":"{fundTypeCode, select, REIT {Total Return} other {Monthly}}","pdp-premium-discount-chart-header-title":"Premium Discount","pdp-premium-discount-chart-time-period-label":"Time Period","pdp-premium-discount-chart-prior-year-label":"Prior Year","pdp-premium-discount-chart-training-days-label":"Trading Days in Period:","pdp-premium-discount-chart-market-price-below-nav-label":"MARKET PRICE BELOW NAV","pdp-premium-discount-chart-market-price-at-or-below-nav-label":"MARKET PRICE AT OR ABOVE NAV","pdp-premium-discount-chart-greatest-premium-label":"Greatest Premium","pdp-premium-discount-chart-greatest-discount-label":"Greatest Discount","pdp-premium-discount-chart-days-within-point-five-label":"Days within 0.5% of NAV","pdp-premium-discount-chart-days-at-premium-label":"Days at Premium","pdp-premium-discount-chart-days-at-discount-label":"Days at Discount","pdp-dividends-tab-label":"DIVIDENDS & CAPITAL GAINS","pdp-distributions-tab-label":"DISTRIBUTIONS","pdp-dividend-subheader-ex-date":"Ex-Date","pdp-dividend-subheader-reinvest-nav":"Reinvest NAV","pdp-dividend-subheader-record-date":"Record Date","pdp-dividend-subheader-pay-date":"Pay Date","pdp-dividend-subheader-dividend-amount":"{fundTypeCode, select, REIT {$ Per Share Distribution} other {Dividend Paid} }","pdp-dividends-card-label":"{fundTypeCode, select, REIT {$ Per Share Distribution} SMA {Dividend history} other {Dividend Schedule} }","pdp-capital-fie