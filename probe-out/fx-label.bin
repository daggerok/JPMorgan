{"date-format":"{month}/{date}/{year}","date-format-month-year":"{month}/{year}","fx-total-funds-label":"{total} Available Shareclasses","fx-shareclass":"{type, select, etf {Inception Date} other {Share Class} }","pdp-overview-sample-withdrawal":"Sample Withdrawal Amount","pdp-overview-fund-facts-cut-off-label":"Cut-off Time","pdp-overview-fund-facts":"{fundType, select, 529Plans {Portfolio Facts} REIT {Portfolio Facts} SMA {Strategy Facts} other {Fund Facts}}","pdp-overview-fund-stats":"{fundType, select, 529Plans {Portfolio Stats} REIT {Portfolio Stats} SMA {Strategy Stats} other {Fund Stats}}","pdp-fund-inception-date":"{fundType, select, 529Plans {Portfolio Inception Date} REIT {Portfolio Inception Date} SMA {Strategy Inception Date} other {Fund Inception Date}}","pdp-shareclass-inception-date":"{fundType, select, Commingled {Class of Units Inception Date} 529Plans {Unit Class Inception Date} INV_TRUST {Trust Inception date} other {Share Class Inception Date}}","pdp-asset-class-label":"Asset Class","pdp-portfolio-top-holding-asset-class":"Asset Class","pdp-bloomberg-ticker-label":"Ticker","fund-currency":"Fund Currency","pdp-fund-manager-in-the-industry":"In the industry","pdp-fund-manager-with-jp-morgan":"With J.P. Morgan","pdp-fund-manager-with":"With {fundSubAdvisor}","pdp-fund-manager-portfolio-manager":"Fund Managers","pdp-quick-stat-taxable-equivalent-yield":"TAXABLE EQUIVALENT YIELD","pdp-quick-stat-daily-yield":"DAILY YIELD","pdp-quick-stat-annualised-distribution-rate":"Annualized Distribution Rate","shareclass-currency":"Share Class Currency","pdp-currency-in-millions":"{currency}{amount} Mn","pdp-currency-in-billions":"{currency}{amount} Bn","pdp-currency-in-trillions":"{currency}{amount} Tn","pdp-daily-holdings-download-button":"Download all holdings","pdp-daily-holdings-download-button-xls":"Download all holdings (XLS)","pdp-daily-holdings-download-button-pdf":"Download all holdings (PDF)","pdp-label-nav-display":"NAV Change ($)","pdp-label-nav-perc